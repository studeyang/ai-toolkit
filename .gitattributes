# 统一换行符，避免 Windows 提交后别人 clone 下来整文件 diff
* text=auto eol=lf

# 脚本必须保持 LF，否则在 Linux/Mac 上会因 shebang 后的 \r 而执行失败
*.py     text eol=lf
*.sh     text eol=lf
*.ts     text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf

# 二进制文件不做换行转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.svg    text eol=lf
